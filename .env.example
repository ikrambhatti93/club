APP_NAME="Strip Clubs Barcelona"
APP_ENV=production
APP_KEY=base64:GENERATE_KEY_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_TIMEZONE="Europe/Madrid"
APP_URL=https://stripclubsbcn.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Hostinger MySQL Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456789_stripclubsbcn
DB_USERNAME=u123456789_admin
DB_PASSWORD="your_secure_mysql_password_here"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=""

# Hostinger / Custom SMTP Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=reservations@stripclubsbcn.com
MAIL_PASSWORD="your_email_password_here"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="reservations@stripclubsbcn.com"
MAIL_FROM_NAME="Strip Clubs Barcelona VIP Concierge"

# Business & Concierge Settings
CONCIERGE_WHATSAPP="+34600123456"
CONCIERGE_PHONE="+34931234567"
ADMIN_NOTIFICATION_EMAIL="manager@stripclubsbcn.com"
DEFAULT_CURRENCY="EUR"
AGE_GATE_ENABLED=true
AGE_GATE_MINIMUM=18

# Payment Gateways Configuration
PAYMENT_MODE=test
STRIPE_PUBLIC_KEY="pk_test_placeholder"
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

REDSYS_MERCHANT_CODE=""
REDSYS_KEY=""
REDSYS_TERMINAL="1"

# Google Maps / Analytics
GOOGLE_MAPS_API_KEY=""
GOOGLE_ANALYTICS_ID=""

# AI Studio / Cloud Run Injection (if applicable)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
